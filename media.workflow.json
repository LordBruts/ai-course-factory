    "Wait For Render": {
      "main": [
        [
          {
            "node": "Check Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Render": {
      "main": [
        [
          {
            "node": "Render Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Status": {
      "main": [
        [
          {
            "node": "Render Complete",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Render Failed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Render Failed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait For Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
