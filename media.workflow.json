            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Sub-workflow. Sends a gated course package to the course-media worker (PPTX with speaker notes, narrated MP4, worksheet/quiz/exam/answer-key DOCX), polls until done, records assets, and optionally copies files to Supabase Storage. IN: version_id, package, config. OUT: { job_id, files[], video_seconds, tts_provider, tts_fallback_reason, slide_count, storage_backend }. Writes: assets, course_versions.media_job_id."
  }
}
