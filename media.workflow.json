{
  "name": "GymRamp HF · Produce Media",
  "nodes": [
    {
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "707a52cc-fdf7-5c47-8d4e-307904f192e7"
    },
    {
      "name": "Start Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.worker_url }}/courses/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.package) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "d21abb1c-c04f-5318-81a6-a3248afdeea7"
    },
    {
      "name": "Wait For Render",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "webhookId": "0aee9183-275f-5815-8398-63fe0b237121",
      "id": "008c970d-a6c9-514c-83ce-c2297ba3b220"
    },
    {
      "name": "Check Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        0
      ],
      "parameters": {
        "url": "={{ $('Start').first().json.config.worker_url }}/jobs/{{ $('Start Render').first().json.job_id }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "721f3f7f-6d6f-525f-82b9-feffd93bb18d"
    },
    {
      "name": "Render Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 3
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "done",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "done",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "done"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 3
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "failed",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "failed"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 3
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "timed_out",
                    "leftValue": "={{ $runIndex >= 90 ? 'yes' : 'no' }}",
                    "rightValue": "yes",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "timed_out"
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "162b4f59-df95-5d70-8248-39fa9b8410df"
    },
    {
      "name": "Render Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "errorMessage": "={{ 'Course render failed: ' + ($json.error || ('job ' + $json.job_id + ' still ' + $json.stage + ' after 30 minutes')) }}"
      },
      "id": "9cb3981e-4a97-5ec1-8335-bc588b21aaca"
    },
    {
      "name": "Render Complete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "// Anchors the finished job for everything downstream. The Switch before it ran once\n// per poll, so reading it by name would be ambiguous about which run is meant.\nreturn [{ json: $input.first().json, pairedItem: { item: 0 } }];"
      },
      "id": "d42ebd2c-0ac3-5201-8b4a-24146a512897"
    },
    {
      "name": "Record Assets",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n  INSERT INTO assets (version_id, kind, filename, url, bytes, duration_seconds, storage_backend)\n  SELECT $1, x.kind, x.filename, x.url, x.bytes, x.duration_seconds, 'local'\n  FROM jsonb_to_recordset($2::jsonb) AS x(kind text, filename text, url text, bytes bigint, duration_seconds numeric)\n  ON CONFLICT (version_id, kind, storage_backend)\n  DO UPDATE SET url = EXCLUDED.url, bytes = EXCLUDED.bytes, duration_seconds = EXCLUDED.duration_seconds\n  RETURNING id\n),\nv AS (UPDATE course_versions SET media_job_id = $3, status = 'produced', updated_at = now() WHERE id = $1 RETURNING id)\nSELECT (SELECT count(*) FROM a) AS assets, (SELECT count(*) FROM v) AS versions;",
        "options": {
          "queryReplacement": "={{ [($('Start').first().json.version_id) ?? null, (JSON.stringify($json.files)) ?? null, ($json.job_id) ?? null] }}"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "id": "94c5072b-7d74-5607-8a00-0f2bea491964"
    },
    {
      "name": "Use Supabase Storage?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $('Start').first().json.config.storage_backend === 'supabase' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "1b4c3727-63ee-59e5-819b-5fb0955a056f"
    },
    {
      "name": "Split Files For Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -200
      ],
      "parameters": {
        "jsCode": "// One item per produced file, with where to fetch it and where it goes in the bucket.\nconst job = $('Render Complete').first().json;\nconst s = $('Start').first().json;\nreturn (job.files || []).map((f) => ({\n  json: {\n    kind: f.kind, filename: f.filename, bytes: f.bytes,\n    download_url: s.config.worker_url + f.path,\n    object_path: s.package.course_slug + '/v' + s.package.version + '/' + f.filename,\n  },\n  pairedItem: { item: 0 },\n}));"
      },
      "id": "6f00a177-d917-597d-81bb-ddb7c350f45f"
    },
    {
      "name": "Download Asset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2160,
        -200
      ],
      "parameters": {
        "url": "={{ $json.download_url }}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "f91926cb-c682-5fcf-84cb-7173fb964f21"
    },
    {
      "name": "Upload To Supabase Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2400,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Start').first().json.config.supabase_url }}/storage/v1/object/{{ $('Start').first().json.config.supabase_bucket }}/{{ $('Split Files For Upload').item.json.object_path }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-upsert",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "id": "4b371dad-cab2-5d3d-857e-bab14e25535f"
    },
    {
      "name": "Record Supabase Asset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        2640,
        -200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO assets (version_id, kind, filename, url, bytes, storage_backend)\nVALUES ($1, $2, $3, $4, $5, 'supabase')\nON CONFLICT (version_id, kind, storage_backend) DO UPDATE SET url = EXCLUDED.url, bytes = EXCLUDED.bytes\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [($('Start').first().json.version_id) ?? null, ($('Split Files For Upload').item.json.kind) ?? null, ($('Split Files For Upload').item.json.filename) ?? null, ($('Start').first().json.config.supabase_url + '/storage/v1/object/' + $('Start').first().json.config.supabase_bucket + '/' + $('Split Files For Upload').item.json.object_path) ?? null, ($('Split Files For Upload').item.json.bytes) ?? null] }}"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "id": "fdb8b6a1-ae39-5dec-8af4-6e98eeb58a3b"
    },
    {
      "name": "Return Media",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "job_id",
              "value": "={{ $('Render Complete').first().json.job_id }}",
              "type": "string"
            },
            {
              "id": "f1",
              "name": "files",
              "value": "={{ $('Render Complete').first().json.files }}",
              "type": "array"
            },
            {
              "id": "f2",
              "name": "video_seconds",
              "value": "={{ $('Render Complete').first().json.video_seconds }}",
              "type": "number"
            },
            {
              "id": "f3",
              "name": "slide_count",
              "value": "={{ $('Render Complete').first().json.slide_count }}",
              "type": "number"
            },
            {
              "id": "f4",
              "name": "tts_provider",
              "value": "={{ $('Render Complete').first().json.tts_provider }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "tts_fallback_reason",
              "value": "={{ $('Render Complete').first().json.tts_fallback_reason }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "storage_backend",
              "value": "={{ $('Start').first().json.config.storage_backend }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "executeOnce": true,
      "id": "213ab889-4369-5184-871e-e70431c1acdf"
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Start Render",
