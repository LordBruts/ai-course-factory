{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymramp.local/schemas/storyboard.schema.json",
  "title": "Storyboard",
  "description": "The production artifact that decides how each narration beat is shown. It is saved with the render so any frame can be explained: what was on screen, why, and which source it rests on. Deterministic rules produce it; an LLM pass may refine treatment and emphasis, never content.",
  "type": "object",
  "required": ["version_id", "template", "segments"],
  "additionalProperties": false,
  "properties": {
    "version_id": { "type": "integer" },
    "course_slug": { "type": "string" },
    "template": { "type": "string", "enum": ["faceless", "face"] },
    "content_hash": { "type": "string" },
    "decided_by": { "type": "string", "enum": ["rules", "rules+llm", "agent"] },
    "model": { "type": ["string", "null"] },
    "rules_version": { "type": "integer" },
    "prompt_version": { "type": "integer" },
    "total_seconds": { "type": "number" },
    "sections": {
      "type": "array",
      "description": "Teaching sections derived from the narrative, not from slide boundaries. A section may span slides; a slide may contain several sections.",
      "items": {
        "type": "object",
        "required": ["id", "title", "start", "end"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "slide_indexes": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "start", "end", "narration", "visual_type", "visual_reason"],
        "additionalProperties": false,
        "properties": {
          "segment_id": { "type": "string", "pattern": "^S[0-9]{2,4}$" },
          "section_id": { "type": "string" },
          "slide_index": { "type": "integer", "minimum": 0 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "narration": { "type": "string", "description": "Verbatim approved narration for this beat. Never rewritten here." },
          "beat_type": { "type": "string", "enum": ["opening", "teaching", "evidence", "emphasis", "transition", "recap", "closing"] },
          "visual_type": {
            "type": "string",
            "enum": ["NONE", "TITLE", "TEXT_EMPHASIS", "DIAGRAM", "PROCESS", "COMPARISON", "STATISTIC", "CHART", "B_ROLL", "IMAGE", "SCREEN_CAPTURE", "QUOTE", "EVIDENCE_CARD", "TIMELINE", "ICON_SEQUENCE", "SECTION_TRANSITION", "RECAP"],
            "description": "NONE is a first-class choice: a beat may stay visually quiet, and some should."
          },
          "visual_reason": { "type": "string", "minLength": 3, "description": "Why this treatment helps comprehension. A segment with no defensible reason should be NONE." },
          "component": { "type": "string", "description": "Motion component that renders it, e.g. EvidenceCard." },
          "props": { "type": "object", "description": "Content for the component. Every string must trace to approved course text or a reference entry." },
          "asset_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string", "enum": ["icon", "image", "b_roll", "chart_data", "screen_capture"] },
                "description": { "type": "string" },
                "asset_id": { "type": ["string", "null"] }
              }
            }
          },
          "animation": { "type": "string", "description": "Preset name from brand/motion.json." },
          "emphasis_words": { "type": "array", "items": { "type": "string" }, "description": "Words that carry the point; they must appear verbatim in narration." },
          "citation_ids": { "type": "array", "items": { "type": "string" }, "description": "Evidence markers or reference numbers backing this beat. Validated against references[] before render." },
          "quiet": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
