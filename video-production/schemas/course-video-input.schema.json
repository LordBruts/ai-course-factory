{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymramp.local/schemas/course-video-input.schema.json",
  "title": "CourseVideoInput",
  "description": "The approved course, as the video system receives it. Every field is derived from content that already passed the Citation & Claim Gate and, where relevant, from evidence rows in the database. The video system may re-present this content; it may never add to it.",
  "type": "object",
  "required": ["course_id", "course_version", "version_id", "title", "slides", "video_template"],
  "additionalProperties": false,
  "properties": {
    "course_id": { "type": "integer" },
    "course_version": { "type": "integer", "minimum": 1 },
    "version_id": { "type": "integer", "description": "course_versions.id — the key every render, asset and review row hangs off." },
    "course_slug": { "type": "string" },
    "source_version": { "type": "string", "description": "Hash of the approved package. A render records it so you can tell whether a video matches the course text it came from." },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "audience": { "type": "string" },
    "learning_objectives": { "type": "array", "items": { "type": "string" } },
    "modules": {
      "type": "array",
      "description": "Optional grouping of slides into teaching sections. Absent for the current single-module courses.",
      "items": {
        "type": "object",
        "required": ["title", "slide_indexes"],
        "properties": {
          "title": { "type": "string" },
          "slide_indexes": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "notes"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "title": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string", "description": "Approved speaker notes = the narration. Citation markers are already renumbered [1]…[n] by the gate." },
          "refs": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "kind": { "type": "string", "enum": ["title", "content", "takeaways", "references"], "default": "content" }
        }
      }
    },
    "speaker_notes": {
      "type": "array",
      "description": "Flat narration per slide, in order. Redundant with slides[].notes and supplied for convenience.",
      "items": { "type": "string" }
    },
    "narration_script": { "type": "string", "description": "The full approved narration, concatenated. QA compares the rendered audio transcript against this." },
    "narration_audio": {
      "type": "array",
      "description": "Already-approved narration, when it exists on the course worker. Reusing it costs nothing and keeps the audio identical to what a human approved.",
      "items": {
        "type": "object",
        "required": ["index", "path"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "path": { "type": "string" },
          "url": { "type": "string" },
          "seconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Gate output: every narration sentence with its markers and status. A statement marked blocked must never reach a frame.",
      "items": {
        "type": "object",
        "required": ["text", "status"],
        "properties": {
          "slide_no": { "type": "integer" },
          "text": { "type": "string" },
          "markers": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["cited", "uncited", "blocked"] }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Computed by the gate from structured source records. An on-screen citation MUST come from this list; nothing else is renderable.",
      "items": {
        "type": "object",
        "required": ["n", "citation"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "citation": { "type": "string" },
          "url": { "type": "string" },
          "doi": { "type": "string" },
          "pmid": { "type": "string" },
          "year": { "type": "integer" },
          "journal": { "type": "string" },
          "design": { "type": "string", "description": "Evidence level from course_sources, used to colour and label an evidence card." },
          "population": { "type": "string" },
          "outcome": { "type": "string" }
        }
      }
    },
    "assessment_summary": {
      "type": "object",
      "properties": {
        "quiz_questions": { "type": "integer" },
        "exam_questions": { "type": "integer" },
        "pass_mark_percent": { "type": "integer" }
      }
    },
    "branding": {
      "type": "object",
      "description": "Overrides for the brand tokens. Empty means the tokens in video-production/brand are used as-is.",
      "properties": {
        "logo_path": { "type": "string" },
        "accent": { "type": "string" },
        "course_code": { "type": "string" }
      }
    },
    "media_preferences": {
      "type": "object",
      "properties": {
        "resolution": { "type": "string", "default": "1920x1080" },
        "fps": { "type": "integer", "default": 30 },
        "caption_style": { "type": "string", "enum": ["two_word_upper", "sentence", "none"], "default": "two_word_upper" },
        "visual_density": { "type": "string", "enum": ["quiet", "balanced", "rich"], "default": "balanced" },
        "music": { "type": "boolean", "default": false },
        "voice": { "type": "string", "description": "ElevenLabs voice id; only used when narration must be synthesised." }
      }
    },
    "video_template": { "type": "string", "enum": ["faceless", "face", "not_selected"] },
    "presenter_source": { "$ref": "presenter-video-source.schema.json" },
    "disclaimer": { "type": "string" }
  }
}
